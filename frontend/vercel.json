{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bookmysight.com"
        }
      ],
      "destination": "https://www.bookmysight.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://navi-1.onrender.com/sitemap.xml"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
