// @desc    Verify payment with Cashfree
// @route   GET /api/payments/verify/:orderId
// @access  Private
// @desc    Verify payment with Cashfree
// @route   GET /api/payments/verify/:orderId
// @access  Private
const verifyPayment = async (req, res, next) => {
  try {
    const { orderId } = req.params;
    
    if (!orderId) {
      return next(new ErrorResponse('Order ID is required', 400));
    }

    console.log('Fetching payment status for order:', orderId);

    // Fetch order details from Cashfree
    const response = await cashfree.PGFetchOrder({
      order_id: orderId
    });

    console.log('Cashfree order response:', {
      status: response.status,
      data: response.data
    });

    const orderStatus = response.data?.order_status;
    const paymentStatus = response.data?.payment_status;

    // Check if payment was successful
    if (orderStatus === 'PAID' && paymentStatus === 'SUCCESS') {
      // Update your database here
      const booking = await GuestSightseeingBooking.findOneAndUpdate(
        { 'payment.orderId': orderId },
        {
          $set: {
            'paymentStatus': 'paid',
            'status': 'confirmed',
            'bookingStatus': 'confirmed',
            'payment.status': 'PAID',
            'payment.paymentDate': new Date(),
            'payment.paymentDetails': response.data
          }
        },
        { new: true }
      );

      if (!booking) {
        console.error('Booking not found for order ID:', orderId);
        return res.status(404).json({ 
          success: false, 
          message: 'Booking not found' 
        });
      }

      return res.json({ 
        success: true, 
        message: 'Payment verified successfully',
        data: {
          orderId,
          status: 'PAID',
          amount: response.data.order_amount,
          currency: response.data.order_currency,
          paymentDetails: response.data
        }
      });
    }

    // If payment is still pending
    if (orderStatus === 'ACTIVE' && !paymentStatus) {
      return res.status(200).json({
        success: false,
        message: 'Payment is still pending',
        data: {
          orderId,
          status: 'PENDING',
          paymentDetails: response.data
        }
      });
    }

    // If payment failed
    return res.status(200).json({
      success: false,
      message: `Payment ${paymentStatus || 'failed'}`,
      data: {
        orderId,
        status: paymentStatus || 'FAILED',
        paymentDetails: response.data
      }
    });

  } catch (error) {
    console.error('Error verifying payment:', {
      message: error.message,
      response: error.response?.data,
      stack: error.stack
    });

    return next(new ErrorResponse(
      error.response?.data?.message || 'Error verifying payment',
      error.response?.status || 500
    ));
  }
};
